  "do_not_enforce": [
    {
      "sign": "A dash on its own",
      "why": "In one small count, human essays ranged from 0.33 to 17.12 dashes per 1,000 words. Wikipedia lists dash overuse as a past sign that ended in September 2026.",
      "source": "https://arxiv.org/html/2603.27006v1"
    },
    {
      "sign": "Perfect grammar",
      "why": "Wikipedia lists it as a sign that does not work.",
      "source": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing"
    },
    {
      "sign": "Linking words such as \"however\" and \"moreover\"",
      "why": "Wikipedia lists them as a sign that does not work.",
      "source": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing"
    },
    {
      "sign": "Plain or formal vocabulary",
      "why": "Detectors flagged about 61 in 100 essays by people writing English as a second language.",
      "source": "https://arxiv.org/abs/2304.02819"
    },
    {
      "sign": "One or two overused words",
      "why": "Wikipedia says one or two may be coincidence. Only a cluster counts.",
      "source": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing"
    },
    {
      "sign": "Even sentence lengths",
      "why": "The evidence is weak and mixed.",
      "source": "https://arxiv.org/pdf/2308.09067"
    },
    {
      "sign": "Curly quotation marks",
      "why": "Word processors add them for everyone.",
      "source": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing"
    },
    {
      "sign": "Any AI-detector score",
      "why": "Detectors are easy to fool and wrongly flag real people.",
